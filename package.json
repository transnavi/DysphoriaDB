{
  "name": "gender-experience-index",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build && node scripts/build_site.mjs",
    "dev": "vite --host 0.0.0.0 --port 4174",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:worker && npm run test:content",
    "test:worker": "vitest run",
    "test:content": "node --test tests/i18n.test.mjs && npm run build && node --test tests/build-output.test.mjs && uv run pytest -q",
    "types": "wrangler types --env-interface Env && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "i18next": "^26.3.6"
  }
}
