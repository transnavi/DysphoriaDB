{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transnavi-db-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "REACTIONS_DB",
      "database_name": "dysphoria-db-reactions",
      "database_id": "edce313f-5c93-4c3a-ba90-12b4f841b2fd",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REACTION_RATE_LIMITER",
      "namespace_id": "24081",
      "simple": {
        "limit": 30,
        "period": 10
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "db.transnavi.jp",
      "custom_domain": true
    }
  ]
}
